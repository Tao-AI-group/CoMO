https://uts.nlm.nih.gov/uts/umls/concept/C2717875</rdfs:comment>
        <rdfs:label>Prebiotic</rdfs:label>
        <core:altLabel>Prebiotics</core:altLabel>
        <core:definition>Non-digestible food ingredients mostly of a carbohydrate base that improve human health by selectively stimulating the growth and/or activity of existing BACTERIA in the COLON. (MSH)</core:definition>
        <UMLS_CUI>C2717875</UMLS_CUI>
        <UMLS_Semantic_Type>Organic Chemical</UMLS_Semantic_Type>
    </owl:Class>
    



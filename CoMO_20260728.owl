        <rdfs:comment>Source: CIHLex</rdfs:comment>
        <rdfs:comment>Source: Medical Subject Headings (MeSH)
 http://purl.bioontology.org/ontology/MESH/D058765</rdfs:comment>
        <rdfs:comment>Source: Natural Medicine</rdfs:comment>
        <rdfs:comment>Source: UMLS 
  https://uts.nlm.nih.gov/uts/umls/concept/C2713543</rdfs:comment>
        <rdfs:label>Neurofeedback</rdfs:label>
        <core:altLabel>Brainwave Feedback</core:altLabel>
        <core:altLabel>Brainwave Feedbacks</core:altLabel>
        <core:altLabel>EEG Feedback</core:altLabel>
        <core:altLabel>Electroencephalogram Biofeedback</core:altLabel>
        <core:altLabel>Electroencephalography Biofeedback</core:altLabel>
        <core:altLabel>Neurofeedbacks</core:altLabel>
        <core:definition>[Source: Medical Subject Headings (MeSH)] A technique to self-regulate brain activities provided as a feedback in order to better control or enhance one&apos;s own performance, control or function. This is done by trying to bring brain activities into a range associated with a desired brain function or status. A biofeedback during which a continuous brain wave pattern is shared with the person in order to increase the percentage of a certain type of brain wave, such as ALPHA RHYTHM, which is associated with a state of relaxation.</core:definition>
        <UMLS_CUI>C2713543</UMLS_CUI>
        <UMLS_Semantic_Type>Therapeutic or Preventive Procedure</UMLS_Semantic_Type>
    </owl:Class>
    



<rdf:RDF xmlns="https://github.com/Tao-AI-group/COMBINI#"
     xml:base="https://github.com/Tao-AI-group/COMBINI"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:core="http://www.w3.org/2004/02/skos/core#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="https://github.com/Tao-AI-group/COMBINI">
        <dc:contributor>Halil Kilicoglu</dc:contributor>
        <dc:contributor>Jianfu Li</dc:contributor>
        <dc:contributor>Lu Kang</dc:contributor>
        <dc:contributor>Marcelo Fiszman</dc:contributor>
        <dc:contributor>Robin Austin</dc:contributor>
        <dc:creator>Cui Tao</dc:creator>
        <dc:creator>Haifang Li</dc:creator>
        <dc:description>The Complementary Medicine Ontology (CoMO) is a domain ontology designed to provide standardized representation of complementary medicine concepts and their semantic relationships. CoMO organizes knowledge across three major domains: complementary medicine interventions, products, and systems. It supports semantic interoperability, knowledge integration, knowledge organization, and computational research in complementary and integrative healthcare.</dc:description>
        <dc:title>Complementary Medicine Ontology (CoMO)</dc:title>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</owl:versionInfo>
    </owl:Ontology>
    



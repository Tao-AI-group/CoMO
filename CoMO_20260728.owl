    <!-- https://github.com/Tao-AI-group/COMBINI#000369 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/COMBINI#000369">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/COMBINI#000360"/>
        <rdfs:comment>Source: Medical Subject Headings (MeSH)
 http://purl.bioontology.org/ontology/MESH/D019050</rdfs:comment>
        <rdfs:comment>Source: Physician Data Query (PDQ) Terminology
 http://purl.bioontology.org/ontology/PDQ/CDR0000372888</rdfs:comment>
        <rdfs:comment>Source: Read Codes, Clinical Terms Version 3 (CTV3)
 http://purl.bioontology.org/ontology/RCD/X00Kt</rdfs:comment>
        <rdfs:comment>Source: UMLS 
 https://uts.nlm.nih.gov/uts/umls/concept/C0282614</rdfs:comment>
        <rdfs:label>Acupressure_Therapy</rdfs:label>
        <core:altLabel>acupressure</core:altLabel>
        <core:definition>Application of firm, sustained pressure to special points on the body for therapeutic effect (NIC)</core:definition>
        <core:definition>Applying firm, sustained pressure using fingers and palms to stimulate a client&apos;s energy flow along acupuncture meridian points of his or her body. Any practitioner using this code, other than an acupuncturist or an Oriental medicine practitioner, must document appropriate training and/or certification. Service is billed in 15-minute increments. (ALT)</core:definition>
        <core:definition>The application of non-invasive finger pressure along energy points throughout the body in order to relieve pain and induce a feeling of well-being. (NCI)</core:definition>
        <core:definition>[Source: Medical Subject Headings (MeSH)] A type of massage in which finger pressure on specific body sites is used to promote healing, relieve fatigue, etc. Although the anatomical locations are the same as the ACUPUNCTURE POINTS used in ACUPUNCTURE THERAPY (hence acu-), no needle or other acupuncture technique is employed in acupressure. (From Random House Unabridged Dictionary, 2d ed). Shiatsu is a modern outgrowth that focuses more on prevention than healing.</core:definition>
        <UMLS_CUI>C0282614</UMLS_CUI>
        <UMLS_Semantic_Type>Therapeutic or Preventive Procedure</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/COMBINI#000370 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/COMBINI#000370">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/COMBINI#000360"/>
        <rdfs:comment>Source: Medical Subject Headings (MeSH)
 http://purl.bioontology.org/ontology/MESH/D064746</rdfs:comment>
        <rdfs:comment>Source: UMLS 
 https://uts.nlm.nih.gov/uts/umls/concept/C3658309</rdfs:comment>
        <rdfs:label>Soft_Tissue_Therapy</rdfs:label>
        <core:definition>[Source: Medical Subject Headings (MeSH)] The assessment, treatment, and management of soft tissue injury or dysfunction. Therapy is designed to reduce tension and irritation in affected tissues and may include MASSAGE; muscle stretching, or direct pressure on muscles, connective tissue, and TRIGGER POINTS.</core:definition>
        <UMLS_CUI>C3658309</UMLS_CUI>
        <UMLS_Semantic_Type>Therapeutic or Preventive Procedure</UMLS_Semantic_Type>
    </owl:Class>
    



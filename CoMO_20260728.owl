    <!-- https://github.com/Tao-AI-group/COMBINI#000525 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/COMBINI#000525">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/COMBINI#000518"/>
        <rdfs:comment>Source: CIHLex</rdfs:comment>
        <rdfs:comment>Source: Medical Subject Headings (MeSH)
 http://purl.bioontology.org/ontology/MESH/D015928</rdfs:comment>
        <rdfs:label>Cognitive_Behavioral_Therapy</rdfs:label>
        <core:altLabel>Cognition Therapy</core:altLabel>
        <core:altLabel>Cognitive Behavior Therapy</core:altLabel>
        <core:altLabel>Cognitive Psychotherapy</core:altLabel>
        <core:altLabel>Cognitive Therapy</core:altLabel>
        <core:definition>A directive form of psychotherapy based on the interpretation of situations (cognitive structure of experiences) that determine how an individual feels and behaves. It is based on the premise that cognition, the process of acquiring knowledge and forming beliefs, is a primary determinant of mood and behavior. The therapy uses behavioral and verbal techniques to identify and correct negative thinking that is at the root of the aberrant behavior. (MSH)</core:definition>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/COMBINI#000526 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/COMBINI#000526">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/COMBINI#000518"/>
        <rdfs:comment>Source: CIHLex</rdfs:comment>
        <rdfs:comment>Source: Medical Subject Headings (MeSH)
 http://purl.bioontology.org/ontology/MESH/D000077252</rdfs:comment>
        <rdfs:label>Dialectical_Behavior_Therapy</rdfs:label>
        <core:definition>A flexible, stage-based therapy that combines principles of behavior therapy, cognitive behavior therapy, and MINDFULNESS. It concurrently promotes acceptance and change, especially with difficult-to-treat patients. (MSH)</core:definition>
        <UMLS_CUI>C1321145</UMLS_CUI>
        <UMLS_Semantic_Type>Therapeutic or Preventive Procedure</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/COMBINI#000527 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/COMBINI#000527">

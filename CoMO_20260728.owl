        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/COMBINI#000352"/>
        <rdfs:comment>Source: CIHLex</rdfs:comment>
        <rdfs:comment>Source: UMLS 
 https://uts.nlm.nih.gov/uts/umls/concept/C0695553</rdfs:comment>
        <rdfs:label>Bowen_Therapy</rdfs:label>
        <core:altLabel>Bowen Manipulative Therapy</core:altLabel>
        <core:altLabel>Bowen Technique</core:altLabel>
        <core:altLabel>Technique Bowen</core:altLabel>
        <core:definition>Performing a series of gently rolling connective tissue manipulations and pauses to a client&apos;s body part, region or full body to discern stress in the muscles and/or muscle groups and/or release his or her muscle stress.Any practitioner using this code must document appropriate training and/or certification. Service is billed in 15-minute increments. (ALT)</core:definition>
        <UMLS_CUI>C0695553</UMLS_CUI>
        <UMLS_Semantic_Type>Therapeutic or Preventive Procedure</UMLS_Semantic_Type>
    </owl:Class>
    



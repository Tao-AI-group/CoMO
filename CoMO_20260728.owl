 https://www.nccih.nih.gov/health/passionflower</rdfs:comment>
        <rdfs:label>Passionflower</rdfs:label>
        <core:altLabel>apricot vine</core:altLabel>
        <core:altLabel>maracuja</core:altLabel>
        <core:altLabel>maypop</core:altLabel>
        <core:altLabel>water lemon</core:altLabel>
        <core:definition>[Source: National Center for Complementary and Integrative Health (NCCIH)] Passionflower is a climbing vine that is native to the southeastern United States and Central and South America.</core:definition>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/COMBINI#000587 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/COMBINI#000587">

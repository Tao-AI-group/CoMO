        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/COMBINI#000460"/>
        <rdfs:comment>Source: CIHLex</rdfs:comment>
        <rdfs:comment>Source: Medical Subject Headings (MeSH)
 http://purl.bioontology.org/ontology/MESH/D001326</rdfs:comment>
        <rdfs:comment>Source: Natural Medicine</rdfs:comment>
        <rdfs:comment>Source: UMLS 
 https://uts.nlm.nih.gov/uts/umls/concept/C0004361</rdfs:comment>
        <rdfs:label>Autogenic_Training</rdfs:label>
        <core:altLabel>Autogenic</core:altLabel>
        <core:altLabel>Autogenic Relaxation</core:altLabel>
        <core:altLabel>Autogenic Relaxation Technique</core:altLabel>
        <core:altLabel>Autogenic Relaxation Training</core:altLabel>
        <core:altLabel>Autorelaxation Concentrative</core:altLabel>
        <core:altLabel>Progressive Muscle Relaxation</core:altLabel>
        <core:altLabel>Progressive Relaxation</core:altLabel>
        <core:altLabel>Standard Autogenic Training</core:altLabel>
        <core:definition>Assisting with self-suggestions about feelings of heaviness and warmth for the purpose of inducing relaxation (NIC)</core:definition>
        <core:definition>Physiological form of psychotherapy based on studies of sleep and hypnosis and the application of yoga principles. (PSY)</core:definition>
        <core:definition>[Source: Medical Subject Headings (MeSH)] Technique based on muscle relaxation during self-hypnotic exercises. It is used in conjunction with psychotherapy.</core:definition>
        <core:definition>method of training to reduce stress and bring the autonomic nervous system under voluntary control. (CSP)</core:definition>
        <UMLS_CUI>C0004361</UMLS_CUI>
        <UMLS_Semantic_Type>Therapeutic or Preventive Procedure</UMLS_Semantic_Type>
    </owl:Class>
    



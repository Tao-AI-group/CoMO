    <!-- https://github.com/Tao-AI-group/COMBINI#000552 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/COMBINI#000552">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/COMBINI#000548"/>
        <rdfs:comment>Source: National Center for Complementary and Integrative Health (NCCIH)
  https://www.nccih.nih.gov/health/cinnamon</rdfs:comment>
        <rdfs:label>Cinnamon</rdfs:label>
        <core:altLabel>Ceylon cinnamon</core:altLabel>
        <core:altLabel>cassia cinnamon</core:altLabel>
        <core:altLabel>cinnamon bark</core:altLabel>
        <core:definition>[Source: National Center for Complementary and Integrative Health (NCCIH)]  Cinnamon is a spice that comes from the dried bark of various species of Cinnamomum trees. Ceylon cinnamon (Cinnamomum verum), known as “true” cinnamon, grows primarily in Sri Lanka. Cassia cinnamon (Cinnamomum aromaticum), grown in areas of southeastern Asia, is the most common type sold in North America.</core:definition>
    </owl:Class>
    



 http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C67021</rdfs:comment>
        <rdfs:comment>Source: UMLS 
  https://uts.nlm.nih.gov/uts/umls/concept/C1879795</rdfs:comment>
        <rdfs:label>Behavioral_Dietary_Intervention</rdfs:label>
        <core:definition>The use of operant conditioning to alter a person&apos;s dietary choices and behaviors. (NCI)</core:definition>
        <UMLS_CUI>C1879795</UMLS_CUI>
        <UMLS_Semantic_Type>Health Care Activity</UMLS_Semantic_Type>
    </owl:Class>
    


